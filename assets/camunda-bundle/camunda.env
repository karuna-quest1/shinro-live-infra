# Non-secret settings for the shared demo Camunda. Secrets and HOST are added
# at boot by bin/render-env.sh, which writes the final .env (mode 600).
# Versions are Camunda 8.8.32 as shipped by camunda-distributions@cd44d741.

CAMUNDA_VERSION=8.8.32
CAMUNDA_IDENTITY_VERSION=8.8.15
ELASTIC_VERSION=8.17.10
KEYCLOAK_SERVER_VERSION=quay-26.6.4
POSTGRES_VERSION=15-alpine3.22

# The OMS demo app, built on the instance from this exact commit.
OMS_APP_REPO=https://github.com/karuna-quest1/oms-camunda-application.git
OMS_APP_REF=81c57e0369b4867f3b8fe768119e149ad6961551

# Container-to-container: the compose service name, never a public address.
KEYCLOAK_HOST=keycloak

POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
KEYCLOAK_ADMIN_USER=admin
ORCHESTRATION_CLIENT_ID=orchestration
RESOURCE_AUTHORIZATIONS_ENABLED=true
